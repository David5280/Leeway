{
  "name": "leeway",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "A free, self-hosted budget tracker with bank sync, account alerts, and a secure MCP link for your AI assistant.",
  "homepage": "https://github.com/David5280/Leeway#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/David5280/Leeway.git"
  },
  "bugs": {
    "url": "https://github.com/David5280/Leeway/issues"
  },
  "author": "David Engel",
  "keywords": [
    "budget",
    "personal-finance",
    "self-hosted",
    "plaid",
    "mcp"
  ],
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "npm run dev --workspace server & npm run dev --workspace web",
    "build": "npm run build --workspace web && npm run build --workspace server",
    "start": "npm run start --workspace server",
    "reset-password": "npm run reset-password --workspace server",
    "test": "npm run test --workspaces",
    "typecheck": "npm run typecheck --workspaces && tsc -p e2e",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:coverage": "npm run test:coverage --workspaces",
    "e2e": "playwright test",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.65.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.0.0",
    "prettier": "^3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.73.0"
  }
}
