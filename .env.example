# Postgres connection string. docker compose sets this for you.
DATABASE_URL=postgres://leeway:leeway@localhost:5432/leeway

# Encrypts bank access tokens at rest. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Plaid keys from https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Public URL of this instance (Railway sets RAILWAY_PUBLIC_DOMAIN automatically).
# PUBLIC_URL=https://leeway.example.com
