# Leeway's settings. Copy this file to .env, then fill in what you need:
#   1. ENCRYPTION_KEY, always.
#   2. DATABASE_URL, only when running from source (Docker sets it for you).
#   Everything else is optional; leave it empty to use the default.
# Never commit .env. After changing it, restart Leeway (with Docker: docker compose up -d).

# Required. Encrypts bank access tokens at rest: 64 hex characters.
# Generate with: openssl rand -hex 32
# Keep a copy somewhere safe: without it, connected banks have to be linked again.
ENCRYPTION_KEY=

# Required when running from source. docker-compose.yml sets this for you.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/leeway
# TLS to the database: on by default for any host but this computer. Set true
# or false to choose yourself.
DATABASE_SSL=

# Where Leeway listens. Defaults: port 3000 on every address (0.0.0.0).
PORT=
HOST=

# The address you open Leeway at, for bank webhooks and the AI assistant link.
# Leave empty to use whatever address the browser shows.
PUBLIC_URL=

# Creating your account takes a setup code, so nobody who finds the address first
# can claim it. Set your own here (12 characters or more), or leave it empty and
# Leeway prints a new one in its log at each start until the account exists, on the
# line that starts "No account yet". With Docker: docker compose logs leeway
SETUP_CODE=

# How many proxies sit in front of Leeway, so it knows each visitor's real address
# for its sign-in limits. Leave empty for the usual setups: on Railway it is 1, and
# elsewhere Leeway trusts one reverse proxy on your own machine or network (Caddy,
# nginx). Set 0 if Leeway faces the internet directly, or 2 with a CDN in front too.
TRUST_PROXY=

# Optional bank sync through Plaid. Without it Leeway still runs; add accounts and
# transactions by hand or import them from a CSV file. Free keys: make a Plaid account,
# then copy the client_id and a secret from https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
# The Sandbox secret (test banks), or the Production secret once Plaid approves you
# for real banks. See "Bank sync with Plaid" in the README.
PLAID_SECRET=
# sandbox (Plaid's test banks) or production (your real banks). Match the secret above.
PLAID_ENV=sandbox
# Countries to offer banks from, comma separated
PLAID_COUNTRY_CODES=US
# Needed by some banks that sign in through their own site. It must match an
# address registered under Allowed redirect URIs in the Plaid dashboard.
PLAID_REDIRECT_URI=

# How often to sync every bank in the background, in minutes. 0 turns it off.
SYNC_INTERVAL_MINUTES=360

# Optional. Lets Claude write the summary at the top of the dashboard (you then
# turn it on in Settings, AI assistant) and read the paystubs you import.
# Make a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# The Claude model that writes it. The small default costs cents a month.
SUMMARY_MODEL=claude-haiku-5-5
# The Claude model that reads a paystub you upload, once per new file.
PAYSTUB_MODEL=claude-haiku-5-5

# Optional. Lets Leeway send the weekly email, through Resend (https://resend.com).
# You then turn it on in Settings, Email; nothing is sent until you do.
RESEND_API_KEY=
# The sender: an address on a domain you have verified in Resend, like
# Leeway <leeway@yourdomain.com>
MAIL_FROM=
