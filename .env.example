# Copy to .env and fill in. Never commit .env.

# Required. Encrypts bank access tokens at rest. Generate with: openssl rand -hex 32
# Keep a copy somewhere safe: without it, connected banks have to be linked again.
ENCRYPTION_KEY=

# Required when running from source. docker-compose.yml sets this for you.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/leeway

# The address you open Leeway at, for bank webhooks and the AI assistant link.
# Leave empty to use whatever address the browser shows.
PUBLIC_URL=

# Creating your account takes a setup code, so nobody who finds the address first
# can claim it. Leeway prints a new one in its log at each start until the account
# exists. Set your own here (12 characters or more) if you would rather not read logs.
SETUP_CODE=

# How many proxies sit in front of Leeway, so it knows each visitor's real address
# for its sign-in limits. Leave empty for the usual setups: on Railway it is 1, and
# elsewhere Leeway trusts one reverse proxy on your own machine or network (Caddy,
# nginx). Set 0 if Leeway faces the internet directly, or 2 with a CDN in front too.
TRUST_PROXY=

# Bank sync. Free Plaid keys: https://dashboard.plaid.com/developers/keys
# Without them Leeway still runs; you can add accounts and transactions by hand.
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox (test banks) or production (your real banks)
PLAID_ENV=sandbox
# Countries to offer banks from, comma separated
PLAID_COUNTRY_CODES=US

# How often to sync every bank in the background, in minutes. 0 turns it off.
SYNC_INTERVAL_MINUTES=360

# Optional. Lets Claude write the summary at the top of the dashboard; you then
# turn it on in Customize, AI assistant. Make a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# The Claude model that writes it.
SUMMARY_MODEL=claude-opus-5-5
